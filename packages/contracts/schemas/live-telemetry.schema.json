{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infinite-factory-os/contracts/live-telemetry.schema.json",
  "title": "LiveTelemetryBatchManifest",
  "type": "object",
  "required": [
    "batch_id",
    "lane_id",
    "batch_type",
    "package_scope",
    "publishing_cadence",
    "metadata_lineage_persistence",
    "posts",
    "drift_detection_rules",
    "over_commercialization_rules",
    "human_review_checklist"
  ],
  "properties": {
    "batch_id": { "type": "string", "minLength": 6 },
    "lane_id": { "type": "string", "minLength": 3 },
    "batch_type": { "type": "string", "const": "live-publishing-readiness-batch" },
    "package_scope": {
      "type": "object",
      "required": ["posts_planned", "window", "commercial_injection"],
      "properties": {
        "posts_planned": { "type": "integer", "minimum": 1 },
        "window": { "type": "string", "minLength": 3 },
        "commercial_injection": { "type": "string", "minLength": 3 }
      },
      "additionalProperties": false
    },
    "publishing_cadence": {
      "type": "object",
      "required": ["cadence_notes", "sequence_gap_hours", "max_posts_per_day", "recommended_schedule"],
      "properties": {
        "cadence_notes": { "type": "string", "minLength": 3 },
        "sequence_gap_hours": { "type": "number", "exclusiveMinimum": 0 },
        "max_posts_per_day": { "type": "integer", "minimum": 1 },
        "recommended_schedule": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["sequence", "scheduled_at_utc", "recommended_window_local", "cta_instruction", "notes"],
            "properties": {
              "sequence": { "type": "integer", "minimum": 1 },
              "scheduled_at_utc": { "type": "string", "format": "date-time" },
              "recommended_window_local": { "type": "string", "minLength": 3 },
              "cta_instruction": { "type": "string", "minLength": 3 },
              "notes": { "type": "string", "minLength": 3 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "metadata_lineage_persistence": {
      "type": "array",
      "items": { "type": "string", "minLength": 3 }
    },
    "posts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "backlog_item_id",
          "post_id",
          "published_at_utc",
          "content",
          "publishing_ready_content",
          "attribution_ids",
          "expected_engagement_bands",
          "expected_relationship_effect",
          "expected_publishing_memory",
          "expected_relationship_state",
          "confirm_if",
          "invalidate_if"
        ],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "backlog_item_id": { "type": "string", "minLength": 6 },
          "post_id": { "type": "string", "minLength": 6 },
          "published_at_utc": { "type": "string", "format": "date-time" },
          "content": {
            "type": "object",
            "required": [
              "journey_stage_id",
              "value_arc_id",
              "campaign_theme_id",
              "relationship_objective",
              "audience_state_before",
              "audience_state_after"
            ],
            "properties": {
              "journey_stage_id": { "type": "string", "minLength": 3 },
              "value_arc_id": { "type": "string", "minLength": 3 },
              "campaign_theme_id": { "type": "string", "minLength": 3 },
              "relationship_objective": { "type": "string", "minLength": 3 },
              "audience_state_before": { "type": "string", "minLength": 3 },
              "audience_state_after": { "type": "string", "minLength": 3 }
            },
            "additionalProperties": false
          },
          "publishing_ready_content": {
            "type": "object",
            "required": ["hook", "caption", "suggested_visual_direction", "cta_instructions", "success_metric"],
            "properties": {
              "hook": { "type": "string", "minLength": 3 },
              "caption": { "type": "string", "minLength": 10 },
              "suggested_visual_direction": { "type": "string", "minLength": 3 },
              "cta_instructions": { "type": "string", "minLength": 3 },
              "success_metric": { "type": "string", "minLength": 3 }
            },
            "additionalProperties": false
          },
          "attribution_ids": {
            "type": "object",
            "required": [
              "journey_id",
              "journey_stage_id",
              "value_arc_id",
              "campaign_id",
              "campaign_theme_id",
              "backlog_item_id",
              "asset_id",
              "chain_id"
            ],
            "properties": {
              "journey_id": { "type": "string", "minLength": 3 },
              "journey_stage_id": { "type": "string", "minLength": 3 },
              "value_arc_id": { "type": "string", "minLength": 3 },
              "campaign_id": { "type": "string", "minLength": 3 },
              "campaign_theme_id": { "type": "string", "minLength": 3 },
              "backlog_item_id": { "type": "string", "minLength": 3 },
              "asset_id": { "type": "string", "minLength": 3 },
              "chain_id": { "type": "string", "minLength": 3 },
              "published_post_id": { "type": "string", "minLength": 3 },
              "platform_post_id": { "type": "string", "minLength": 1 },
              "performance_record_id": { "type": "string", "minLength": 3 }
            },
            "additionalProperties": false
          },
          "expected_engagement_bands": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["metric", "target", "min", "max"],
              "properties": {
                "metric": {
                  "type": "string",
                  "enum": ["saves", "shares", "follows", "comments", "lead_captures"]
                },
                "target": { "type": "number", "minimum": 0 },
                "min": { "type": "number", "minimum": 0 },
                "max": { "type": "number", "minimum": 0 },
                "tolerance_ratio": { "type": "number", "minimum": 0, "maximum": 3 }
              },
              "additionalProperties": false
            }
          },
          "expected_relationship_effect": { "type": "string", "minLength": 3 },
          "expected_publishing_memory": {
            "type": "object",
            "required": [
              "trust_band",
              "memory_id",
              "stage_ratio_after",
              "cta_ratio_after",
              "commercial_density_after",
              "trend",
              "saves_shares_follows_delta"
            ],
            "properties": {
              "trust_band": { "type": "string", "enum": ["cold", "warming", "engaged", "trusting", "saturated"] },
              "memory_id": { "type": "string", "minLength": 6 },
              "stage_ratio_after": {
                "type": "object",
                "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "cta_ratio_after": {
                "type": "object",
                "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "commercial_density_after": { "type": "number", "minimum": 0, "maximum": 1 },
              "trend": { "type": "string", "enum": ["up", "down", "flat"] },
              "saves_shares_follows_delta": {
                "type": "object",
                "required": ["saves", "shares", "follows"],
                "properties": {
                  "saves": { "type": "number" },
                  "shares": { "type": "number" },
                  "follows": { "type": "number" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "expected_relationship_state": {
            "type": "object",
            "required": ["state_after_post", "trust_score_estimate", "trust_gate_after", "confidence"],
            "properties": {
              "state_after_post": { "type": "string", "minLength": 3 },
              "trust_score_estimate": { "type": "number", "minimum": 0, "maximum": 1 },
              "trust_gate_after": {
                "type": "string",
                "enum": ["cold", "warming", "engaged", "trusting", "saturated", "over-commercialized"]
              },
              "confidence": { "type": "string", "enum": ["low", "medium", "high"] }
            },
            "additionalProperties": false
          },
          "confirm_if": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
          "invalidate_if": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } }
        },
        "additionalProperties": false
      }
    },
    "drift_detection_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rule_id", "metric", "threshold", "severity", "action"],
        "properties": {
          "rule_id": { "type": "string", "minLength": 3 },
          "metric": { "type": "string", "minLength": 3 },
          "threshold": { "type": "number" },
          "severity": { "type": "string", "enum": ["info", "warn", "critical"] },
          "action": { "type": "string", "minLength": 3 }
        },
        "additionalProperties": false
      }
    },
    "over_commercialization_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rule_id", "metric", "threshold", "window_posts", "warning"],
        "properties": {
          "rule_id": { "type": "string", "minLength": 3 },
          "metric": { "type": "string", "minLength": 3 },
          "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
          "window_posts": { "type": "integer", "minimum": 1 },
          "warning": { "type": "string", "minLength": 3 }
        },
        "additionalProperties": false
      }
    },
    "comparison_plan": {
      "type": "object",
      "properties": {
        "simulated_progression_expectations": {
          "type": "object",
          "required": ["relationship", "publishing_memory", "relationship_state"],
          "properties": {
            "relationship": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["post", "state", "trust_score"],
                "properties": {
                  "post": { "type": "integer", "minimum": 1 },
                  "state": { "type": "string", "minLength": 3 },
                  "trust_score": { "type": "number", "minimum": 0, "maximum": 1 }
                },
                "additionalProperties": false
              }
            },
            "publishing_memory": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["post", "expectation"],
                "properties": {
                  "post": { "type": "integer", "minimum": 1 },
                  "expectation": { "type": "string", "minLength": 3 }
                },
                "additionalProperties": false
              }
            },
            "relationship_state": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["post", "state", "trust_gate_after", "trust_score"],
                "properties": {
                  "post": { "type": "integer", "minimum": 1 },
                  "state": { "type": "string", "minLength": 3 },
                  "trust_gate_after": {
                    "type": "string",
                    "enum": ["cold", "warming", "engaged", "trusting", "saturated", "over-commercialized"]
                  },
                  "trust_score": { "type": "number", "minimum": 0, "maximum": 1 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "real_telemetry_validation_signals": {
          "type": "object",
          "required": ["validates_model_when", "invalidates_model_when"],
          "properties": {
            "validates_model_when": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 3 }
            },
            "invalidates_model_when": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 3 }
            }
          },
          "additionalProperties": false
        },
        "most_likely_wrong_heuristics": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        },
        "sensitive_stages": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        },
        "over_commercialization_risk_hotspots": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        }
      },
      "additionalProperties": false
    },
    "live_ingestion_readiness": {
      "type": "object",
      "required": ["prepared_schema_fields", "required_sources", "capture_instructions"],
      "properties": {
        "prepared_schema_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        },
        "required_sources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        },
        "capture_instructions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        }
      },
      "additionalProperties": false
    },
    "human_review_checklist": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    }
  },
  "additionalProperties": false
}
